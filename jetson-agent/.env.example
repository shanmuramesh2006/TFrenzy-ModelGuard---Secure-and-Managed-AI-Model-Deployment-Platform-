# TFrenzy Jetson Agent - Environment Configuration Example

# Backend API Configuration
TFRENZY_BACKEND_URL=https://localhost:5000
TFRENZY_API_TIMEOUT=30

# Device Identity (must match registered device)
TFRENZY_DEVICE_ID=DEV-JETSON-ORIN-001
TFRENZY_CONFIG_DIR=/etc/tfrenzy

# Deployment Configuration
# TFRENZY_DEPLOYMENT_ID=DEP-123456  # Optional: leave empty to auto-detect
TFRENZY_MODEL_CACHE=/tmp/tfrenzy-models

# TensorRT Configuration (Jetson-specific)
TFRENZY_TRT_ENABLED=true
TFRENZY_CUDA_DEVICE=0

# Security Configuration
TFRENZY_MAX_OFFLINE_DAYS=7
TFRENZY_LICENSE_RENEWAL_HOURS=12
TFRENZY_MEMORY_ENCRYPTION=true
TFRENZY_PERFORMANCE_MONITORING=true

# Logging Configuration
TFRENZY_LOG_LEVEL=INFO
TFRENZY_LOG_FILE=/var/log/tfrenzy-agent.log

# Note: Sensitive data (certificates, keys) should never be in .env
# Keep certificates in secure filesystem (e.g., /etc/tfrenzy with 0600 permissions)
