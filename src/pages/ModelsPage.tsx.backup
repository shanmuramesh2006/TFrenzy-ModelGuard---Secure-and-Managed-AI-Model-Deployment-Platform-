import React, { useState } from 'react';
import { useApp } from '../context/AppContext';
import { ModelPackage } from '../types';
import {
  Box,
  Plus,
  Lock,
  FileCode,
  ShieldCheck,
  Ban,
  Eye,
  X,
  Key,
  HardDrive,
  Cpu,
  AlertTriangle
} from 'lucide-react';
import { formatBytes } from '../services/cryptoEngine';

export const ModelsPage: React.FC = () => {
  const { models, addModel, revokeModel } = useApp();

  const [isModalOpen, setIsModalOpen] = useState(false);
  const [selectedModelForManifest, setSelectedModelForManifest] = useState<ModelPackage | null>(null);
  const [revokeModalModel, setRevokeModalModel] = useState<ModelPackage | null>(null);
  const [revokeReason, setRevokeReason] = useState('');

  // Form states
  const [modelName, setModelName] = useState('');
  const [modelVersion, setModelVersion] = useState('v1.0.0');
const [selectedFile, setSelectedFile] = useState<File | null>(null);
const [fileName, setFileName] = useState('');
  const [precision, setPrecision] = useState<'FP16' | 'INT8' | 'FP32'>('FP16');
  const [inputShape, setInputShape] = useState('1x3x640x640');
  const [isPackaging, setIsPackaging] = useState(false);

  const handleUploadSubmit = async (e: React.FormEvent) => {
  e.preventDefault();

  if (!modelName) {
    alert('Model name is required');
    return;
  }

  if (!selectedFile) {
    alert('Please select a TensorRT .engine file');
    return;
  }

  setIsPackaging(true);

  try {
    const response = await fetch(
      '/api/model-packages/encrypt-test',
      {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          fileName: selectedFile.name,
          modelName,
          modelVersion,
        }),
      }
    );

    const result = await response.json();

    if (!response.ok || !result.success) {
      throw new Error(
        result.error || 'Model packaging failed'
      );
    }

    await addModel({
      name: modelName,
      version: modelVersion,
      originalFileName: selectedFile.name,
      originalSizeBytes: selectedFile.size,
      encryptedSizeBytes: result.encryptedSizeBytes,
      trtVersion: 'TensorRT 8.5.2',
      inputShape,
      precision,
    });

    alert('Model encrypted and packaged successfully');

    setIsModalOpen(false);
    setModelName('');
    setModelVersion('v1.0.0');
    setSelectedFile(null);
    setFileName('');
  } catch (error: any) {
    console.error('Model packaging failed:', error);
    alert(error.message || 'Model packaging failed');
  } finally {
    setIsPackaging(false);
  }
};

  const handleRevokeSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (!revokeModalModel) return;
    revokeModel(revokeModalModel.id, revokeReason || 'Security administrative recall');
    setRevokeModalModel(null);
    setRevokeReason('');
  };

  return (
    <div className="space-y-6">
      {/* Header Banner */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 glass-panel p-6 rounded-2xl border border-[#1E2638]">
        <div>
          <h1 className="text-xl font-extrabold text-white flex items-center gap-2">
            <Box className="w-5 h-5 text-[#00F0FF]" />
            TensorRT Model Packaging & Encryption Engine
          </h1>
          <p className="text-xs text-[#9CA3AF] mt-1 font-mono">
            Converts unmanaged TensorRT <code className="text-[#00F0FF] bg-[#07090E] px-1.5 py-0.5 rounded border border-[#1E2638]">.engine</code> files into AES-256-GCM encrypted, RSA-3072 digitally signed <code className="text-[#00F0FF] bg-[#07090E] px-1.5 py-0.5 rounded border border-[#1E2638]">.tfmodel</code> packages.
          </p>
        </div>

        <button
          onClick={() => setIsModalOpen(true)}
          className="bg-gradient-to-r from-[#2563EB] to-[#00F0FF] hover:opacity-90 text-[#07090E] font-extrabold px-5 py-3 rounded-xl text-xs transition-all uppercase tracking-wider flex items-center justify-center gap-2 shrink-0 font-mono shadow-lg shadow-[#00F0FF]/15 cursor-pointer"
        >
          <Plus className="w-4 h-4 stroke-[2.5]" />
          <span>Package & Encrypt Model</span>
        </button>
      </div>

      {/* Models Grid */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {models.map(model => {
          const isRevoked = model.status === 'revoked';

          return (
            <div
              key={model.id}
              className={`glass-card rounded-2xl p-6 flex flex-col justify-between transition-all border ${
                isRevoked ? 'border-red-500/40 bg-red-950/10' : 'border-[#1E2638] hover:border-[#2D3A54]'
              }`}
            >
              <div>
                {/* Header Row */}
                <div className="flex items-start justify-between gap-2 mb-3">
                  <div className="w-9 h-9 rounded-xl bg-[#111625] border border-[#1E2638] flex items-center justify-center text-[#00F0FF] shrink-0">
                    <FileCode className="w-4 h-4" />
                  </div>
                  <div className="text-right">
                    <span
                      className={`inline-block px-2.5 py-1 rounded-md text-[10px] font-mono font-bold uppercase ${
                        isRevoked
                          ? 'bg-red-500/15 text-red-400 border border-red-500/30'
                          : 'bg-emerald-500/15 text-emerald-400 border border-emerald-500/30'
                      }`}
                    >
                      {model.status}
                    </span>
                  </div>
                </div>

                <h3 className="text-lg font-extrabold text-white">{model.name}</h3>
                <div className="text-xs text-[#00F0FF] font-mono font-bold mt-0.5">
                  VERSION: {model.version}
                </div>

                {/* Details List */}
                <div className="mt-4 space-y-2 text-xs border-t border-b border-[#1E2638] py-3.5 font-mono">
                  <div className="flex justify-between text-[#6B7280]">
                    <span>ENGINE:</span>
                    <span className="text-white font-medium">{model.originalFileName}</span>
                  </div>
                  <div className="flex justify-between text-[#6B7280]">
                    <span>SIZE:</span>
                    <span className="text-white font-medium">{formatBytes(model.encryptedSizeBytes)}</span>
                  </div>
                  <div className="flex justify-between text-[#6B7280]">
                    <span>SHAPE:</span>
                    <span className="text-[#00F0FF] font-semibold">{model.precision} ({model.inputShape})</span>
                  </div>
                  <div className="flex justify-between text-[#6B7280]">
                    <span>ENCRYPTION:</span>
                    <span className="text-emerald-400 font-bold">{model.encryptionAlgo}</span>
                  </div>
                  <div className="flex justify-between text-[#6B7280]">
                    <span>SIGNATURE:</span>
                    <span className="text-indigo-300 font-bold">{model.signatureAlgo}</span>
                  </div>
                </div>

                {/* Package Hash */}
                <div className="mt-3.5 bg-[#090D18] p-3 rounded-xl border border-[#1E2638]">
                  <span className="text-[10px] text-[#6B7280] uppercase font-bold tracking-wider block mb-1 font-mono">
                    SHA-256 PACKAGE HASH
                  </span>
                  <p className="font-mono text-[10px] text-[#9CA3AF] break-all leading-tight">
                    {model.packageHash}
                  </p>
                </div>
              </div>

              {/* Action Buttons */}
              <div className="mt-5 pt-3.5 border-t border-[#1E2638] flex items-center justify-between gap-2">
                <button
                  onClick={() => setSelectedModelForManifest(model)}
                  className="flex-1 bg-[#111625] hover:bg-[#151C2E] text-white text-xs font-mono font-bold py-2.5 rounded-xl transition-all flex items-center justify-center gap-1.5 border border-[#1E2638] hover:border-[#2D3A54] cursor-pointer"
                >
                  <Eye className="w-3.5 h-3.5 text-[#00F0FF]" />
                  <span>INSPECT MANIFEST</span>
                </button>

                {!isRevoked && (
                  <button
                    onClick={() => setRevokeModalModel(model)}
                    className="bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 text-xs font-mono font-bold py-2.5 px-3.5 rounded-xl transition-all flex items-center gap-1 cursor-pointer"
                  >
                    <Ban className="w-3.5 h-3.5" />
                    <span>REVOKE</span>
                  </button>
                )}
              </div>
            </div>
          );
        })}
      </div>

      {/* Package & Encrypt Modal */}
      {isModalOpen && (
        <div className="fixed inset-0 bg-[#07090E]/80 backdrop-blur-md flex items-center justify-center p-4 z-50">
          <div className="bg-[#0D121F] border border-[#1E2638] rounded-2xl w-full max-w-lg p-6 shadow-2xl relative">
            <button
              onClick={() => setIsModalOpen(false)}
              className="absolute right-4 top-4 text-[#6B7280] hover:text-white p-1 rounded-lg"
            >
              <X className="w-5 h-5" />
            </button>

            <h2 className="text-lg font-extrabold text-white flex items-center gap-2 mb-1">
              <Lock className="w-5 h-5 text-[#00F0FF]" />
              Package & Encrypt TensorRT Model
            </h2>
            <p className="text-xs text-[#9CA3AF] mb-5">
              Generates AES-256-GCM symmetric key, encrypts model payload, and calculates RSA-3072 digital signature.
            </p>

            <form onSubmit={handleUploadSubmit} className="space-y-4">
              <div>
                <label className="block text-xs font-semibold text-[#9CA3AF] mb-1">Model Name</label>
                <input
                  type="text"
                  value={modelName}
                  onChange={e => setModelName(e.target.value)}
                  placeholder="e.g. YOLOv8x Object Detector"
                  required
                  className="w-full bg-[#07090E] border border-[#1E2638] rounded-xl px-3.5 py-2.5 text-sm text-white placeholder-[#6B7280] focus:outline-none focus:border-[#00F0FF]"
                />
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block text-xs font-semibold text-[#9CA3AF] mb-1">Version Tag</label>
                  <input
                    type="text"
                    value={modelVersion}
                    onChange={e => setModelVersion(e.target.value)}
                    placeholder="v1.0.0"
                    required
                    className="w-full bg-[#07090E] border border-[#1E2638] rounded-xl px-3.5 py-2.5 text-sm text-white font-mono focus:outline-none focus:border-[#00F0FF]"
                  />
                </div>
                <div>
                  <label className="block text-xs font-semibold text-[#9CA3AF] mb-1">Engine File Name</label>
                  <input
  type="file"
  accept=".engine"
  onChange={(e) => {
    const file = e.target.files?.[0] || null;

    if (file && !file.name.toLowerCase().endsWith(".engine")) {
      alert("Please select a TensorRT .engine file");
      e.target.value = "";
      setSelectedFile(null);
      setFileName("");
      return;
    }

    setSelectedFile(file);
    setFileName(file?.name || "");
  }}
  required
  className="w-full bg-[#07090E] border border-[#1E2638] rounded-xl px-3.5 py-2.5 text-sm text-white font-mono focus:outline-none focus:border-[#00F0FF]"
/>

{selectedFile && (
  <p className="mt-1 text-[10px] text-[#9CA3AF] font-mono">
    Selected: {selectedFile.name} (
    {(selectedFile.size / 1024 / 1024).toFixed(2)} MB
    )
  </p>
)}
</div>
      {/* Manifest Inspector Modal */}
      {selectedModelForManifest && (
        <div className="fixed inset-0 bg-[#07090E]/80 backdrop-blur-md flex items-center justify-center p-4 z-50">
          <div className="bg-[#0D121F] border border-[#1E2638] rounded-2xl w-full max-w-2xl p-6 shadow-2xl relative">
            <button
              onClick={() => setSelectedModelForManifest(null)}
              className="absolute right-4 top-4 text-[#6B7280] hover:text-white p-1 rounded-lg"
            >
              <X className="w-5 h-5" />
            </button>

            <h2 className="text-lg font-extrabold text-white flex items-center gap-2 mb-1">
              <FileCode className="w-5 h-5 text-[#00F0FF]" />
              Package Manifest (.tfmodel)
            </h2>
            <p className="text-xs text-[#6B7280] mb-4 font-mono">
              Package ID: {selectedModelForManifest.id}
            </p>

            <pre className="bg-[#07090E] p-4 rounded-xl border border-[#1E2638] font-mono text-xs text-[#00F0FF] overflow-x-auto max-h-96 leading-relaxed">
{JSON.stringify(
  {
    tfrenzy_manifest_version: "2.0.0",
    model_id: selectedModelForManifest.id,
    model_name: selectedModelForManifest.name,
    version: selectedModelForManifest.version,
    original_engine: selectedModelForManifest.originalFileName,
    target_hardware: selectedModelForManifest.architecture,
    tensorrt_version: selectedModelForManifest.trtVersion,
    encryption: {
      algorithm: selectedModelForManifest.encryptionAlgo,
      key_derivation: "PBKDF2-HMAC-SHA256",
      iv_size_bits: 96,
      auth_tag_size_bits: 128
    },
    signature: {
      algorithm: selectedModelForManifest.signatureAlgo,
      signing_key_id: selectedModelForManifest.signingKeyId,
      value: selectedModelForManifest.signature
    },
    hashes: {
      package_sha256: selectedModelForManifest.packageHash
    },
    created_at: selectedModelForManifest.createdAt,
    created_by: selectedModelForManifest.createdBy
  },
  null,
  2
)}
            </pre>

            <div className="mt-5 flex justify-end">
              <button
                onClick={() => setSelectedModelForManifest(null)}
                className="bg-[#111625] hover:bg-[#151C2E] text-white text-xs font-semibold py-2.5 px-5 rounded-xl border border-[#1E2638] cursor-pointer"
              >
                Close Inspector
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Revoke Modal */}
      {revokeModalModel && (
        <div className="fixed inset-0 bg-[#07090E]/80 backdrop-blur-md flex items-center justify-center p-4 z-50">
          <div className="bg-[#0D121F] border border-[#1E2638] rounded-2xl w-full max-w-md p-6 shadow-2xl relative">
            <button
              onClick={() => setRevokeModalModel(null)}
              className="absolute right-4 top-4 text-[#6B7280] hover:text-white p-1 rounded-lg"
            >
              <X className="w-5 h-5" />
            </button>

            <h2 className="text-lg font-extrabold text-red-400 flex items-center gap-2 mb-1">
              <AlertTriangle className="w-5 h-5 text-red-400" />
              Revoke Model Package
            </h2>
            <p className="text-xs text-[#9CA3AF] mb-4">
              Revoking <strong className="text-white">{revokeModalModel.name}</strong> will instantly block key release requests across all Jetson devices.
            </p>

            <form onSubmit={handleRevokeSubmit} className="space-y-4">
              <div>
                <label className="block text-xs font-semibold text-[#9CA3AF] mb-1">Revocation Reason</label>
                <textarea
                  value={revokeReason}
                  onChange={e => setRevokeReason(e.target.value)}
                  placeholder="e.g. Vulnerability discovered in weights, administrative recall"
                  required
                  rows={3}
                  className="w-full bg-[#07090E] border border-[#1E2638] rounded-xl p-3 text-xs text-white placeholder-[#6B7280] focus:outline-none focus:border-red-500"
                />
              </div>

              <div className="flex justify-end gap-3">
                <button
                  type="button"
                  onClick={() => setRevokeModalModel(null)}
                  className="px-4 py-2.5 text-xs font-semibold text-[#6B7280] hover:text-white cursor-pointer"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  className="bg-red-500 hover:bg-red-600 text-white font-bold px-5 py-2.5 rounded-xl text-xs transition-all cursor-pointer shadow-lg shadow-red-500/20"
                >
                  Confirm Permanent Revocation
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
};

